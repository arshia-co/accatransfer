# ACCA Smart Apply — frontend environment (Vite).
# Copy to `.env` and fill in. NEVER put the OpenAI key here — it lives only
# server-side as a Supabase secret (see DEPLOY.md). The anon key is safe to
# ship to the browser (it is row-level-security gated).

VITE_SUPABASE_URL=https://YOUR-NEW-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional override; defaults to ${VITE_SUPABASE_URL}/functions/v1
# VITE_SUPABASE_FUNCTIONS_URL=

# Shared public catalog. These defaults are used when omitted.
# VITE_ACCA_SITE_URL=https://www.accaco.com
# VITE_ACCA_CATALOG_URL=https://www.accaco.com/data/programs.json

# Cloudflare Turnstile public site key for auth, AI, OCR and upload gates.
# The matching secret belongs in Supabase Edge Function secrets as TURNSTILE_SECRET_KEY.
# When this is empty, the frontend skips the gate for local/demo builds.
# VITE_TURNSTILE_SITE_KEY=

# Server-side only: set these as Supabase Edge Function secrets, never as VITE_.
# TURNSTILE_SECRET_KEY=
# TELEGRAM_BOT_TOKEN=
# AUTHORIZED_TELEGRAM_ADMIN_IDS=123456789,987654321
# TELEGRAM_ADMIN_ALLOW_UNVERIFIED=false
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=ACCA Admissions <no-reply@accatransfer.com>
# APP_BASE_URL=https://accatransfer.com
